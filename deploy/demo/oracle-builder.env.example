# Copy to /etc/oracle-builder/orchestrator.env; do not put raw tokens in Git.
# The systemd unit reads this file.  Restrict it to the oracle-builder account.
# Keep the single quotes: systemd removes them while preserving the JSON quotes.
ORACLE_ORCHESTRATOR_ROLE_TOKENS_SHA256='{"operator":"sha256:REPLACE_WITH_SHA256"}'
ORACLE_ARTIFACT_S3_BUCKET=oracle-builder-demo
ORACLE_ARTIFACT_S3_PREFIX=demo
ORACLE_ARTIFACT_S3_ENDPOINT_URL=https://s3.example.invalid
ORACLE_ARTIFACT_S3_REGION=us-east-1
ORACLE_WORKER_DEPLOYMENT_PROFILES=/etc/oracle-builder/worker-deployments.json

# Use the normal AWS SDK provider chain.  Prefer an instance/service identity.
# For a static demo credential, point AWS_SHARED_CREDENTIALS_FILE at a 0600 file
# owned by oracle-builder; do not add AWS_ACCESS_KEY_ID here.
AWS_SHARED_CREDENTIALS_FILE=/etc/oracle-builder/aws-credentials
