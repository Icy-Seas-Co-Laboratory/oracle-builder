# Copy to .env, replace the values, and keep it private (it contains the raw
# operator token used only by the Web GUI server-side proxy).

# Must be an absolute host path. The prepare script creates its durable tree.
ORACLE_DOCKER_DATA_ROOT=/srv/oracle-builder

# localhost is suitable for a local demo. Set a real DNS name for Caddy TLS.
ORACLE_PUBLIC_HOST=localhost

# Generate a raw token with `openssl rand -hex 32`; keep this private.
ORCHESTRATOR_OPERATOR_TOKEN=REPLACE_WITH_RAW_OPERATOR_TOKEN
# Replace only the digest. The Orchestrator never receives the raw token here.
ORACLE_ORCHESTRATOR_ROLE_TOKENS_SHA256={"operator":"sha256:REPLACE_WITH_SHA256"}

# Leave empty to keep the readable local artifact tree as primary storage.
ORACLE_ARTIFACT_S3_BUCKET=
ORACLE_ARTIFACT_S3_PREFIX=oracle-builder
ORACLE_ARTIFACT_S3_ENDPOINT_URL=
ORACLE_ARTIFACT_S3_REGION=
